{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1240px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"customGradient": true,
			"customDuotone": false,
			"palette": [
				{
					"slug": "primary",
					"name": "Abidar Primary",
					"color": "#0c6a5a"
				},
				{
					"slug": "primary-dark",
					"name": "Abidar Primary Dark",
					"color": "#084a40"
				},
				{
					"slug": "accent",
					"name": "Abidar Accent",
					"color": "#c8912f"
				},
				{
					"slug": "ink",
					"name": "Abidar Ink",
					"color": "#101b1c"
				},
				{
					"slug": "body",
					"name": "Abidar Body",
					"color": "#4a5758"
				},
				{
					"slug": "surface",
					"name": "Abidar Sand",
					"color": "#f5f4f0"
				},
				{
					"slug": "dark",
					"name": "Abidar Dark",
					"color": "#0b1516"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#ffffff"
				}
			],
			"gradients": [
				{
					"slug": "primary",
					"name": "Primary to Dark",
					"gradient": "linear-gradient(150deg, #0c6a5a 0%, #084a40 100%)"
				},
				{
					"slug": "accent",
					"name": "Accent to Primary",
					"gradient": "linear-gradient(150deg, #c8912f 0%, #0c6a5a 100%)"
				},
				{
					"slug": "sand",
					"name": "Sand to White",
					"gradient": "linear-gradient(180deg, #f5f4f0 0%, #ffffff 100%)"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Vazirmatn",
					"fontFamily": "\"Vazirmatn\", \"Segoe UI\", Tahoma, sans-serif"
				},
				{
					"slug": "heading",
					"name": "Sora",
					"fontFamily": "\"Sora\", \"Vazirmatn\", \"Segoe UI\", sans-serif"
				},
				{
					"slug": "mono",
					"name": "Monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.85rem"
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1rem"
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.35rem"
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "2rem"
				},
				{
					"slug": "xx-large",
					"name": "Display",
					"size": "3.1rem"
				}
			]
		},
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true,
			"customSpacingSize": true,
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			],
			"spacingSizes": [
				{
					"slug": "20",
					"name": "Tight",
					"size": "0.75rem"
				},
				{
					"slug": "30",
					"name": "Small",
					"size": "1.25rem"
				},
				{
					"slug": "40",
					"name": "Medium",
					"size": "2rem"
				},
				{
					"slug": "50",
					"name": "Large",
					"size": "3rem"
				},
				{
					"slug": "60",
					"name": "Extra large",
					"size": "4.5rem"
				}
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "soft",
					"name": "Soft",
					"shadow": "0 10px 30px rgba(16, 27, 28, 0.08)"
				},
				{
					"slug": "card",
					"name": "Card",
					"shadow": "0 18px 44px rgba(16, 27, 28, 0.12)"
				},
				{
					"slug": "deep",
					"name": "Deep",
					"shadow": "0 30px 70px rgba(9, 18, 19, 0.24)"
				}
			]
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				},
				"spacing": {
					"padding": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--surface)",
			"text": "var(--wp--preset--color--body)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "1rem",
			"lineHeight": "1.75"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "0",
				"right": "0"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600",
					"lineHeight": "1.25"
				},
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "clamp(2rem, 4vw, 3.1rem)",
					"lineHeight": "1.12"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "clamp(1.5rem, 2.8vw, 2.15rem)",
					"lineHeight": "1.2"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "1.28rem"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary-dark)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "#ffffff"
				},
				"border": {
					"radius": "8px"
				},
				"spacing": {
					"padding": {
						"top": "0.8rem",
						"bottom": "0.8rem",
						"left": "1.6rem",
						"right": "1.6rem"
					}
				},
				"typography": {
					"fontWeight": "600",
					"fontSize": "0.95rem"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--primary-dark)"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "0.8rem"
				},
				"color": {
					"text": "var(--wp--preset--color--body)"
				}
			}
		},
		"blocks": {
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--accent)",
						"style": "solid",
						"width": "3px"
					}
				},
				"spacing": {
					"padding": {
						"left": "1.5rem"
					}
				}
			},
			"core/separator": {
				"color": {
					"background": "var(--wp--preset--color--primary)"
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "0.92rem"
				}
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-templates/about",
			"title": "Abidar About",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-templates/services",
			"title": "Abidar Services",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-templates/projects",
			"title": "Abidar Projects",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-templates/team",
			"title": "Abidar Team",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-templates/contact",
			"title": "Abidar Contact",
			"postTypes": [
				"page"
			]
		}
	]
}
